# Keep the build context small. models/weights/ is intentionally NOT ignored —
# the trained artefacts must ship in the image.

.git
.gitignore

# The Next.js site — deploys separately to Vercel, backend doesn't need it.
web/

# Training datasets (rebuilt offline; not needed to serve).
data/bigearthnet_txt/
data/worldcover/
data/indiasat/
data/aoi_fetch/
data/uploads/
data/*.parquet
data/*.zip

# Notebooks and local run output.
notebooks/
vault/runs/
logs_*.txt

# Python / editor cruft.
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
*.tsbuildinfo
.vercel/
.DS_Store

# Large local archives / media that may sit in the tree.
*.zip
*.mp4
